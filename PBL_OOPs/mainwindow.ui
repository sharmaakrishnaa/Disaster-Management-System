}
QLabel#formSubtitleLabel, QLabel#emailLabel, QLabel#passwordLabel {
    color: #53657C;
    font-size: 10pt;
}
QLineEdit#emailInput, QLineEdit#passwordInput {
    background-color: #F8FAFD;
    color: #172B46;
    border: 1px solid #CFD9E6;
    border-radius: 7px;
    padding: 12px;
    selection-background-color: #2374D8;
}
QLineEdit#emailInput:focus, QLineEdit#passwordInput:focus {
    border: 2px solid #2374D8;
}
QPushButton#loginButton {
    background-color: #1672D5;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 12px;
    font-weight: 700;
}
QPushButton#loginButton:hover {
    background-color: #0D60B9;
}
QPushButton#loginButton:pressed {
    background-color: #084B93;
}
QPushButton#registerButton {
    background-color: white;
    color: #1672D5;
    border: 1px solid #1672D5;
    border-radius: 7px;
    padding: 11px;
    font-weight: 700;
}
QPushButton#registerButton:hover {
    background-color: #EDF5FF;
}
QLabel#messageLabel {
    color: #C0392B;
    font-size: 9pt;
}
QLabel#footerLabel {
    color: #8FA8C8;
    font-size: 9pt;
}</string>
